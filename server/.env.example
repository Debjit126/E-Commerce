# Server
PORT=4000
# Comma-separated list of browser origins allowed to call this API (storefront + admin panel)
CORS_ORIGINS=http://localhost:3008,http://localhost:3002
CLIENT_BASE_URL=http://localhost:3008

# MongoDB
CONNECTION_STRING=mongodb+srv://<user>:<password>@<cluster>/<db>

# Auth: use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JSON_WEB_TOKEN_SECRET_KEY=2u32EpTjPu+kHLeXgACQwmVNnH8IJFEetbT/jq3TynYD7jd7o/5k1vmyV/s32oba
JWT_EXPIRES_IN=7d
# Firebase project used for Google sign-in (same project id as the frontends)
FIREBASE_PROJECT_ID=

# Razorpay (secret stays on the server only, never in a REACT_APP_ variable)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email (OTP / password reset)
EMAIL=
EMAIL_PASS=

# Cloudinary (image uploads)
cloudinary_Config_Cloud_Name=
cloudinary_Config_api_key=
cloudinary_Config_api_secret=
